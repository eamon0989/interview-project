{
  "name": "dmp-explorer-poc",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "env": "node set-env.js",
    "start:frontend:dev": "npm run env && nx run frontend:serve:development",
    "start:backend:dev": "nx run backend:serve:development",
    "lint": "nx run-many --target=lint --all",
    "build": "npm run env && nx run-many --target=build --projects=frontend,backend",
    "build:all": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "ng:component": "npx nx generate @nx/angular:component",
    "ng:lib": "nx generate @nx/angular:library",
    "lint:fix": "npx eslint --ext .ts --fix",
    "prettier": "npx prettier --write .",
    "format": "npm run prettier && npm run lint:fix",
    "start:docker": "docker-compose up -d",
    "stop:docker": "docker-compose down",
    "heroku-postbuild": "npm run build && npm run typeorm:build-config",
    "typeorm:build-config": "npx tsc --experimentalDecorators  --emitDecoratorMetadata apps/backend/typeorm.config.ts --outDir ./dist",
    "typeorm:generate-migrations": "npx typeorm -d dist/typeorm.config.js migration:generate",
    "typeorm:run-migrations": "npx typeorm -d dist/typeorm.config.js migration:run"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.0.6",
    "@angular/cdk": "21.0.5",
    "@angular/common": "21.0.6",
    "@angular/compiler": "21.0.6",
    "@angular/core": "21.0.6",
    "@angular/forms": "21.0.6",
    "@angular/material": "19.2.9",
    "@angular/platform-browser": "21.0.6",
    "@angular/platform-browser-dynamic": "21.0.6",
    "@angular/router": "21.0.6",
    "@auth0/auth0-angular": "2.2.3",
    "@nestjs/common": "11.1.11",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.11",
    "@nestjs/mapped-types": "2.1.0",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.11",
    "@nestjs/serve-static": "5.0.4",
    "@nestjs/swagger": "11.2.3",
    "@nestjs/terminus": "11.0.0",
    "@nestjs/typeorm": "11.0.0",
    "auth0": "4.3.1",
    "axios": "^1.6.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "express-oauth2-jwt-bearer": "1.7.2",
    "file-type-mime": "0.3.10",
    "jwks-rsa": "3.1.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.11.3",
    "reflect-metadata": "0.1.13",
    "rxjs": "7.8.0",
    "ts-mixer": "6.0.4",
    "tslib": "2.3.0",
    "typeorm": "0.3.20",
    "zone.js": "0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.0.4",
    "@angular-devkit/core": "21.0.4",
    "@angular-devkit/schematics": "21.0.4",
    "@angular-eslint/eslint-plugin": "21.1.0",
    "@angular-eslint/eslint-plugin-template": "21.1.0",
    "@angular-eslint/template-parser": "21.1.0",
    "@angular/cli": "21.0.4",
    "@angular/compiler-cli": "21.0.6",
    "@angular/language-service": "21.0.6",
    "@angular/material": "21.0.5",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "^11.1.11",
    "@nx/angular": "22.3.3",
    "@nx/eslint": "22.3.3",
    "@nx/eslint-plugin": "22.3.3",
    "@nx/jest": "22.3.3",
    "@nx/js": "22.3.3",
    "@nx/nest": "22.3.3",
    "@nx/node": "22.3.3",
    "@nx/web": "22.3.3",
    "@nx/webpack": "22.3.3",
    "@nx/workspace": "22.3.3",
    "@schematics/angular": "21.0.4",
    "@swc-node/register": "1.9.2",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/express": "4.17.25",
    "@types/jest": "30.0.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.12.0",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@typescript-eslint/utils": "^7.16.0",
    "autoprefixer": "^10.4.0",
    "eslint": "~8.57.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "jest-environment-node": "^29.4.1",
    "jest-preset-angular": "16.0.0",
    "jest-util": "30.2.0",
    "nx": "22.3.3",
    "postcss": "^8.4.5",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.0.2",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.1",
    "typescript": "5.9.3",
    "webpack-cli": "^5.1.4"
  },
  "lint-staged": {
    "src/**/*.{js,ts}": [
      "npm run format",
      "git add"
    ]
  }
}
